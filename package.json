{
  "name": "bdd-api-framework",
  "version": "1.0.0",
  "description": "Advanced BDD-based API and UI automation framework using Cucumber, Playwright, and GitHub Actions",
  "main": "index.js",
  "scripts": {
  "test": "cucumber-js",
  "test:smoke": "cucumber-js --tags \"@smoke\"",
  "test:api": "cucumber-js --tags \"@api\"",
  "test:hybrid": "cucumber-js --tags \"@hybrid\""
},
  "keywords": [
  "api-testing",
  "ui-automation",
  "bdd",
  "cucumber",
  "playwright",
  "automation-testing",
  "sdet"
  ],
  "author": "Praveen",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
